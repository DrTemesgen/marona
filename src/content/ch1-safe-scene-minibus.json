  "lines": [
    {
      "id": "passerby_opening",
      "characterId": "passerby",
      "text": "Oh no! That old man just fell down by the minibus stop!",
      "emotion": "panicked"
    },
    {
      "id": "passerby_opening_b",
      "characterId": "passerby",
      "text": "Did you see that? An old man fell as he got off the minibus!",
      "emotion": "worried"
    },
    {
      "id": "man_opening",
      "characterId": "man",
      "text": "(He lies on the pavement, holding his leg.) Oh... my leg...",
      "emotion": "pain"
    },
    {
      "id": "passerby_warns",
      "characterId": "passerby",
      "text": "Okay. I will stand on the pavement and wave so the cars slow down.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "passerby_road",
      "characterId": "passerby",
      "text": "Watch out! That minibus nearly hit you! Get back on the pavement!",
      "emotion": "panicked",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "man_answers",
      "characterId": "man",
      "text": "Yes... I can hear you. What happened? I do not know... My leg hurts a lot.",
      "emotion": "worried"
    },
    {
      "id": "calltaker_answer",
      "characterId": "calltaker",
      "text": "907 ambulance. Stay on the line with me. Where are you?",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "calltaker_where",
      "characterId": "calltaker",
      "text": "The minibus stop next to the petrol station. Got it.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "calltaker_what",
      "characterId": "calltaker",
      "text": "An older man fell and hurt his leg. Okay.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "calltaker_number",
      "characterId": "calltaker",
      "text": "One person is hurt. Okay.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "calltaker_awake",
      "characterId": "calltaker",
      "text": "He is awake and breathing. Good. Watch him and tell me if that changes.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "calltaker_advice",
      "characterId": "calltaker",
      "text": "An ambulance is coming. Stay with him and do not move him. Keep him still, calm and warm. If he gets worse, call 907 again.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "passerby_minibus",
      "characterId": "passerby",
      "text": "Let's lift him into a minibus and take him to hospital ourselves.",
      "emotion": "worried",
      "wrongAdvice": true,
      "correctionHarmId": "harm_minibus",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "man_stand_pain",
      "characterId": "man",
      "text": "Aaah! My leg! I cannot stand up!",
      "emotion": "pain"
    },
    {
      "id": "man_lift_pain",
      "characterId": "man",
      "text": "Aaah! Stop! Put me down, it hurts!",
      "emotion": "pain",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "passerby_put_down",
      "characterId": "passerby",
      "text": "Okay, okay. Put him down gently. We should wait for the ambulance.",
      "emotion": "worried",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "passerby_stay",
      "characterId": "passerby",
      "text": "Hey, do not leave him alone! Stay with him and use your phone.",
      "emotion": "worried",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "man_still",
      "characterId": "man",
      "text": "Okay... I will lie still.",
      "emotion": "pain",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "man_calm",
      "characterId": "man",
      "text": "Thank you for staying with me, my child. I feel a little better.",
      "emotion": "calm"
    },
    {
      "id": "man_warm",
      "characterId": "man",
      "text": "That is better. I was getting cold.",
      "emotion": "calm"
    },
    {
      "id": "crew_arrive",
      "characterId": "crew",
      "text": "We are the ambulance crew. Tell us what happened.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "crew_late",
      "characterId": "crew",
      "text": "We are the ambulance crew. It was hard to find you. Next time, tell 907 a landmark. What happened?",
      "emotion": "worried",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    },
    {
      "id": "crew_thanks",
      "characterId": "crew",
      "text": "Thank you. You kept him safe, still and warm. We will take care of him now.",
      "emotion": "calm",
      "ref": {
        "sourceId": "ifrc2025",
        "page": "to confirm",
        "review": "pending"
      }
    }
  ],
  "openingLineIds": [
    "passerby_opening",
    "man_opening"
  ],
