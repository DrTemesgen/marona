{
  "id": "ch1-safe-scene-minibus",
  "chapter": 1,
  "title": "The minibus stop",
  "shortTitle": "Safe scene",
  "version": "0.1.0",
  "scene": "minibus-stop",
  "intro": "After school you wait at the minibus stop next to a petrol station. Cars and minibuses pass close by. An older man gets off a minibus, trips and falls on the pavement. Keep yourself safe and help him.",
  "sources": [
    {
      "id": "ifrc2025",
      "title": "IFRC International First Aid, Resuscitation and Education Guidelines 2025",
      "url": "https://www.ifrc.org/document/ifrc-international-first-aid-resuscitation-and-education-guidelines-2025"
    }
  ],
  "characters": [
    {
      "id": "man",
      "name": "Older man",
      "role": "casualty",
      "description": "An older man who fell on the pavement at the stop. He is awake, confused about what happened, and has hurt his leg."
    },
    {
      "id": "passerby",
      "name": "Passer-by",
      "role": "bystander",
      "description": "A worried passer-by who wants to help. He can warn the traffic, but he also gives wrong advice."
    },
    {
      "id": "calltaker",
      "name": "907 call-taker",
      "role": "calltaker",
      "description": "The call-taker at 907, the free ambulance number for Addis Ababa. Asks where you are and what happened."
    },
    {
      "id": "crew",
      "name": "Ambulance crew",
      "role": "adult",
      "description": "The ambulance team who take over when they arrive."
    }
  ],
  "facts": [
    {
      "id": "fact_traffic",
      "text": "Minibuses and cars pass close to the kerb. Stepping into the road is not safe."
    },
    {
      "id": "fact_pavement",
      "text": "He is lying on the pavement, not in the road. Where he is, he is not in danger."
    },
    {
      "id": "fact_one_hurt",
      "text": "No one else is hurt."
    },
    {
      "id": "fact_landmark",
      "text": "The minibus stop is next to a petrol station."
    },
    {
      "id": "fact_awake",
      "text": "He is awake and talking, so he is breathing. He is confused about what happened, and his leg hurts."
    }
  ],
  "phases": [
    {
      "id": "scene",
      "title": "Is it safe?"
    },
    {
      "id": "call",
      "title": "On the phone to 907"
    },
    {
      "id": "care",
      "title": "Wait with him"
    },
    {
      "id": "handover",
      "title": "The ambulance arrives"
    }
  ],
  "startPhaseId": "scene",
  "startCasualty": "collapsed",
  "initialFlags": {
    "talked": false,
    "locationGiven": false,
    "minibusIdea": false,
    "crewHere": false
  },
  "actions": [
    {
      "id": "check_danger",
      "label": "Look for danger",
      "kind": "action",
      "phases": [
        "scene"
      ],
      "effects": [
        {
          "type": "revealFact",
          "factId": "fact_traffic"
        },
        {
          "type": "revealFact",
          "factId": "fact_pavement"
        },
        {
          "type": "revealFact",
          "factId": "fact_one_hurt"
        },
        {
          "type": "revealFact",
          "factId": "fact_landmark"
        }
      ],
      "hint": "Before you go to him, stop and look. Watch for cars and minibuses that could hit you."
    },
    {
      "id": "warn_traffic",
      "label": "Ask someone to warn cars",
      "kind": "action",
      "targetCharacterId": "passerby",
      "phases": [
        "scene",
        "care"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "passerby",
          "lineId": "passerby_warns"
        }
      ],
      "hint": "Ask a person nearby to stand on the pavement and wave so drivers slow down."
    },
    {
      "id": "run_into_road",
      "label": "Run into the road to stop cars",
      "kind": "action",
      "phases": [
        "scene"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "passerby",
          "lineId": "passerby_road"
        }
      ],
      "hint": "Think: who gets hurt if a minibus cannot stop in time?"
    },
    {
      "id": "ask_response",
      "label": "Ask: Can you hear me?",
      "kind": "question",
      "targetCharacterId": "man",
      "phases": [
        "scene",
        "call",
        "care"
      ],
      "effects": [
        {
          "type": "setFlag",
          "flag": "talked",
          "value": true
        },
        {
          "type": "revealFact",
          "factId": "fact_awake"
        },
        {
          "type": "say",
          "characterId": "man",
          "lineId": "man_answers"
        }
      ],
      "hint": "Kneel beside him on the pavement and speak clearly. Is he awake? Can he talk to you?"
    },
    {
      "id": "call_907",
      "label": "Call 907",
      "kind": "call",
      "targetCharacterId": "calltaker",
      "phases": [
        "scene"
      ],
      "effects": [
        {
          "type": "gotoPhase",
          "phaseId": "call"
        },
        {
          "type": "say",
          "characterId": "calltaker",
          "lineId": "calltaker_answer"
        }
      ],
      "hint": "907 is the free ambulance number in Addis Ababa. Call early, from a safe place."
    },
    {
      "id": "say_where",
      "label": "Say where we are",
      "kind": "question",
      "targetCharacterId": "calltaker",
      "phases": [
        "call"
      ],
      "effects": [
        {
          "type": "addCounter",
          "counter": "callInfo",
          "delta": 1
        },
        {
          "type": "setFlag",
          "flag": "locationGiven",
          "value": true
        },
        {
          "type": "say",
          "characterId": "calltaker",
          "lineId": "calltaker_where"
        }
      ],
      "hint": "Give a landmark people know. Here: the minibus stop next to the petrol station."
    },
    {
      "id": "say_what",
      "label": "Say what happened",
      "kind": "question",
      "targetCharacterId": "calltaker",
      "phases": [
        "call"
      ],
      "effects": [
        {
          "type": "addCounter",
          "counter": "callInfo",
          "delta": 1
        },
        {
          "type": "say",
          "characterId": "calltaker",
          "lineId": "calltaker_what"
        }
      ],
      "hint": "Keep it short: an older man fell and hurt his leg."
    },
    {
      "id": "say_how_many",
      "label": "Say how many are hurt",
      "kind": "question",
      "targetCharacterId": "calltaker",
      "phases": [
        "call"
      ],
      "effects": [
        {
          "type": "addCounter",
          "counter": "callInfo",
          "delta": 1
        },
        {
          "type": "say",
          "characterId": "calltaker",
          "lineId": "calltaker_number"
        }
      ],
      "hint": "Say how many people are hurt. Here: one."
    },
    {
      "id": "say_awake",
      "label": "Say if awake and breathing",
      "kind": "question",
      "targetCharacterId": "calltaker",
      "phases": [
        "call"
      ],
      "requires": {
        "flag": "talked",
        "equals": true
      },
      "effects": [
        {
          "type": "addCounter",
          "counter": "callInfo",
          "delta": 1
        },
        {
          "type": "say",
          "characterId": "calltaker",
          "lineId": "calltaker_awake"
        }
      ],
      "hint": "Tell them what you found: he is awake and talking, so he is breathing."
    },
    {
      "id": "hang_up",
      "label": "Hang up quickly",
      "kind": "action",
      "phases": [
        "call"
      ],
      "effects": [
        {
          "type": "gotoPhase",
          "phaseId": "care"
        }
      ],
      "hint": "Has the call-taker finished with you yet?"
    },
    {
      "id": "ask_what_now",
      "label": "Ask: What should I do now?",
      "kind": "question",
      "targetCharacterId": "calltaker",
      "phases": [
        "call"
      ],
      "requires": {
        "counter": "callInfo",
        "atLeast": 4
      },
      "effects": [
        {
          "type": "say",
          "characterId": "calltaker",
          "lineId": "calltaker_advice"
        },
        {
          "type": "gotoPhase",
          "phaseId": "care"
        }
      ],
      "hint": "Stay on the line until the call-taker has finished. Listen to what they tell you."
    },
    {
      "id": "keep_still",
      "label": "Tell him to lie still",
      "kind": "action",
      "targetCharacterId": "man",
      "phases": [
        "care"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "man",
          "lineId": "man_still"
        }
      ],
      "hint": "Do not move him unless he is in danger. Moving a hurt leg can make it worse."
    },
    {
      "id": "reassure",
      "label": "Talk to him calmly",
      "kind": "action",
      "targetCharacterId": "man",
      "phases": [
        "care"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "man",
          "lineId": "man_calm"
        }
      ],
      "hint": "Tell him help is coming and that you will stay with him."
    },
    {
      "id": "keep_warm",
      "label": "Cover him with a jacket",
      "kind": "action",
      "targetCharacterId": "man",
      "phases": [
        "care"
      ],
      "effects": [
        {
          "type": "setCasualty",
          "status": "lying_awake"
        },
        {
          "type": "say",
          "characterId": "man",
          "lineId": "man_warm"
        }
      ],
      "hint": "A hurt person gets cold easily, even on a warm day. Put a jacket or shawl over him."
    },
    {
      "id": "help_stand",
      "label": "Help him stand up",
      "kind": "action",
      "targetCharacterId": "man",
      "phases": [
        "scene",
        "care"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "man",
          "lineId": "man_stand_pain"
        }
      ],
      "hint": "Is he in danger where he is? If not, should he be moved?"
    },
    {
      "id": "lift_minibus",
      "label": "Lift him into a minibus",
      "kind": "action",
      "targetCharacterId": "man",
      "phases": [
        "scene",
        "care"
      ],
      "requires": {
        "flag": "minibusIdea",
        "equals": true
      },
      "effects": [
        {
          "type": "say",
          "characterId": "man",
          "lineId": "man_lift_pain"
        },
        {
          "type": "say",
          "characterId": "passerby",
          "lineId": "passerby_put_down"
        }
      ],
      "hint": "Who can keep his leg still and care for him on the way: a minibus or the ambulance crew?"
    },
    {
      "id": "leave_him",
      "label": "Leave him and run for help",
      "kind": "action",
      "phases": [
        "scene",
        "care"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "passerby",
          "lineId": "passerby_stay"
        }
      ],
      "hint": "Your phone can bring help. Should he be left alone?"
    },
    {
      "id": "tell_crew",
      "label": "Tell the crew what happened",
      "kind": "action",
      "targetCharacterId": "crew",
      "phases": [
        "handover"
      ],
      "effects": [
        {
          "type": "say",
          "characterId": "crew",
          "lineId": "crew_thanks"
        },
        {
          "type": "setCasualty",
          "status": "handover"
        },
        {
          "type": "endGame",
          "outcome": "handed_over"
        }
      ],
      "hint": "Tell them what you saw and did: he fell, hurt his leg, is awake and breathing, and you kept him still and warm."
    }
  ],
  "timeline": [
