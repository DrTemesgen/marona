        }
      },
      {
        "id": "said_how_many",
        "description": "Told 907 how many people are hurt",
        "check": {
          "kind": "did",
          "actionId": "say_how_many"
        },
        "points": 5,
        "critical": false,
        "teachingPoint": "Say how many people are hurt, so 907 sends enough help.",
