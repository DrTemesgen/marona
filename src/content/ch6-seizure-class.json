        "points": 15,
        "critical": true,
        "teachingPoint": "Stay calm and note the time when the shaking starts. If it lasts more than 5 minutes, call 907.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "clear_space",
        "description": "Moved hard things away",
        "check": { "kind": "didWithin", "actionId": "clear_space", "withinMs": 30000 },
        "points": 10,
        "critical": true,
        "teachingPoint": "Move desks, chairs and other hard things away so he cannot hurt himself.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "cushion_head",
        "description": "Cushioned his head",
        "check": { "kind": "didWithin", "actionId": "cushion_head", "withinMs": 30000 },
        "points": 10,
        "critical": true,
        "teachingPoint": "Put something soft under his head, like a folded jacket.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "call_when_needed",
        "description": "Called 907 when it was needed",
        "check": { "kind": "didWithin", "actionId": "call_907", "withinMs": 45000, "fromEventId": "call_needed" },
        "points": 15,
        "critical": true,
        "teachingPoint": "Call 907 if the seizure lasts more than 5 minutes, if it is a first seizure, if the person is hurt or has trouble breathing, or if another seizure follows.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" },
        "appliesWhen": { "flag": "call_needed" }
      },
      {
        "id": "check_breathing",
        "description": "Checked his breathing when the shaking stopped",
        "check": { "kind": "didWithin", "actionId": "check_breathing", "withinMs": 30000, "fromEventId": "seizure_stops" },
        "points": 10,
        "critical": true,
        "teachingPoint": "When the shaking stops, check that he is breathing normally.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "recovery_position",
        "description": "Put him on his side once he was breathing normally",
        "check": { "kind": "did", "actionId": "recovery_position" },
        "points": 15,
        "critical": true,
        "teachingPoint": "Once he is breathing normally, put him on his side. This keeps his airway open while he wakes up.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "stay_with",
        "description": "Stayed with him and talked calmly",
        "check": { "kind": "did", "actionId": "stay_with" },
        "points": 10,
        "critical": false,
        "teachingPoint": "Stay with him until he is fully awake. Talk calmly and tell him what happened.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "ask_history",
        "description": "Asked if this had happened before",
        "check": { "kind": "did", "actionId": "ask_history" },
        "points": 5,
        "critical": false,
        "teachingPoint": "Find out if this is his first seizure. A first seizure always needs 907.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      }
    ],
    "harms": [
      {
        "id": "h_hold_down",
        "description": "Held him down",
        "actionId": "harm_hold_down",
        "deduction": 20,
        "teachingPoint": "Do not hold a person down during a seizure. It does not stop the seizure, and it can hurt them or you.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "h_tongue",
        "description": "Put fingers in his mouth to hold his tongue",
        "actionId": "harm_tongue",
        "deduction": 30,
        "teachingPoint": "Put nothing in the mouth. A person cannot swallow their tongue. Fingers or objects can break teeth, block the airway or get bitten.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      },
      {
        "id": "h_water",
        "description": "Poured water on his face",
        "actionId": "harm_water",
        "deduction": 20,
        "teachingPoint": "Water does not stop a seizure, and he could breathe it in. Keep him safe and let the shaking stop by itself.",
        "ref": { "sourceId": "ifrc2025", "page": "399-400", "review": "pending" }
      }
    ],
